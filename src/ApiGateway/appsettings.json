{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "auth-policy",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeadersCopy": "true" },
          { "X-Forwarded": "Set" }
        ]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "RateLimiterPolicy": "default-policy",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeadersCopy": "true" },
          { "X-Forwarded": "Set" }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "RateLimiterPolicy": "default-policy",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeadersCopy": "true" },
          { "X-Forwarded": "Set" }
        ]
      },
      "cart-route": {
        "ClusterId": "order-cluster",
        "RateLimiterPolicy": "default-policy",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeadersCopy": "true" },
          { "X-Forwarded": "Set" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service-node": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-service-node": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-service-node": {
            "Address": "http://localhost:5103"
          }
        }
      }
    }
  }
}
